{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "job-ninjas/apps/web",
      "framework": "nextjs"
    },
    "ai-workflow": {
      "root": "job-ninjas/services/ai-workflow",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/ai-workflow/(.*)",
      "destination": {
        "service": "ai-workflow"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
